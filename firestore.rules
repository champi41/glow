rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function myUserDoc() {
      return get(myUserPath()).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(myUserPath()) && myUserDoc().role == 'superadmin';
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && exists(myUserPath()) && myUserDoc().tenantId == tenantId;
    }

    function canManageTenant(tenantId) {
      return isSuperAdmin() || isTenantMember(tenantId);
    }

    // Users
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      // Solo superadmin puede crear/editar perfiles (evita auto-escalado de rol/tenantId)
      allow create, update, delete: if isSuperAdmin();
    }

    // Tenants
    match /tenants/{tenantId} {
      allow read: if true;

      // Superadmin o miembros del tenant pueden administrar el doc.
      allow create, update, delete: if canManageTenant(tenantId);

      // Professionals
      match /professionals/{profId} {
        allow read: if true;
        allow create, update, delete: if canManageTenant(tenantId);

        // Reports per professional: /tenants/{tenantId}/professionals/{profId}/reports/{yyyy-MM}
        match /reports/{reportId} {
          // Lectura: miembros del tenant o el propio profesional
          allow read: if canManageTenant(tenantId) || (isSignedIn() && myUserDoc().professionalId == profId);
          // Escritura: miembros del tenant o el propio profesional
          allow create, update, delete: if canManageTenant(tenantId) || (isSignedIn() && myUserDoc().professionalId == profId);
        }
      }

      // Services
      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if canManageTenant(tenantId);
      }

      // Bookings: lectura y creación públicas; update/delete solo admin, salvo acciones del cliente sin login
      match /bookings/{bookingId} {
        allow read: if true;
        allow create: if true;
        // Admin del tenant puede hacer cualquier update/delete
        allow update, delete: if canManageTenant(tenantId)
        // Cliente sin login: solo subir comprobante de abono
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['depositStatus', 'depositProofUrl'])
            && request.resource.data.depositStatus == 'uploaded'
            && request.resource.data.depositProofUrl is string
            && request.resource.data.depositProofUrl.size() > 0)
        // Cliente sin login: solo cancelar (status -> cancelled) marcando origen
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == 'client'
          && resource.data.status in ['pending', 'confirmed']);
      }

      // Booking slots: lectura pública para disponibilidad; escritura solo sistema/admin
      match /bookingSlots/{slotId} {
        allow read: if true;
        allow create: if request.resource.data.status == 'active'
          && request.resource.data.bookingId is string
          && request.resource.data.dateStr is string
          && request.resource.data.professionalId is string
          && request.resource.data.startTime is string;

        allow update: if canManageTenant(tenantId)
          || (
            request.resource.data.status == 'active'
            && request.resource.data.bookingId is string
            && request.resource.data.dateStr is string
            && request.resource.data.professionalId is string
            && request.resource.data.startTime is string
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled'
            && resource.data.bookingId is string
            && get(/databases/$(database)/documents/tenants/$(tenantId)/bookings/$(resource.data.bookingId)).data.status == 'cancelled'
          );

        allow delete: if canManageTenant(tenantId);
      }

      // Blocks
      match /blocks/{blockId} {
        allow read: if true;
        allow create, update, delete: if canManageTenant(tenantId);
      }

      // Reviews
      match /reviews/{reviewId} {
        allow read, create: if true;
        allow update, delete: if canManageTenant(tenantId);
      }

      // Reports: informes mensuales (/tenants/{tenantId}/reports/{yyyy-MM})
      match /reports/{reportId} {
        // Solo miembros del tenant o superadmin pueden leer y modificar los informes
        allow read: if canManageTenant(tenantId);
        allow create, update, delete: if canManageTenant(tenantId);
      }
    }
  }
}
